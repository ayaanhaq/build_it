{
  "name": "build_it",
  "version": "1.0.0",
  "description": "A deterministic rule checker and instruction generator for physical electronics builds.",
  "main": "index.js",
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "python -m unittest discover tests",
    "generate:scene": "node --experimental-strip-types scripts/generate-scene.ts",
    "dev:server": "node --experimental-strip-types server/generateServer.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayaanhaq/build_it.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ayaanhaq/build_it/issues"
  },
  "homepage": "https://github.com/ayaanhaq/build_it#readme",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  }
}
