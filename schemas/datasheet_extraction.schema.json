{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DatasheetExtraction",
  "description": "Schema for component electrical facts and pinout extracted from datasheets, including provenance.",
  "type": "object",
  "required": ["part_number", "part_type", "pins", "provenance"],
  "properties": {
    "part_number": {
      "type": "string",
      "minLength": 1
    },
    "part_type": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "pins": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": {
            "type": "string",
            "enum": ["gpio", "power", "ground", "anode", "cathode", "passive", "output", "input"]
          },
          "level": {
            "oneOf": [
              {"type": "number"},
              {"type": "string", "enum": ["UNVERIFIED"]}
            ]
          },
          "v": {
            "oneOf": [
              {"type": "number"},
              {"type": "string", "enum": ["UNVERIFIED"]}
            ]
          },
          "max_source_ma": {
            "oneOf": [
              {"type": "number"},
              {"type": "string", "enum": ["UNVERIFIED"]}
            ]
          },
          "max_sink_ma": {
            "oneOf": [
              {"type": "number"},
              {"type": "string", "enum": ["UNVERIFIED"]}
            ]
          },
          "_comment": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "is_sensor": {
      "type": "boolean"
    },
    "vf": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "enum": ["UNVERIFIED"]}
      ]
    },
    "vbe": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "enum": ["UNVERIFIED"]}
      ]
    },
    "max_ma": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "enum": ["UNVERIFIED"]}
      ]
    },
    "max_collector_ma": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "enum": ["UNVERIFIED"]}
      ]
    },
    "coil_voltage": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "enum": ["UNVERIFIED"]}
      ]
    },
    "coil_current_ma": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "enum": ["UNVERIFIED"]}
      ]
    },
    "has_flyback_diode": {
      "type": "boolean"
    },
    "has_driver_transistor": {
      "type": "boolean"
    },
    "provenance": {
      "type": "object",
      "required": ["source", "extraction_method", "confidence"],
      "properties": {
        "source": {
          "type": "object",
          "required": ["document_name", "document_sha256"],
          "properties": {
            "document_name": {
              "type": "string",
              "minLength": 1
            },
            "document_sha256": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            },
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "extracted_at": {
          "type": "string"
        },
        "extraction_method": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "field_provenance": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["page", "raw_text"],
            "properties": {
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "raw_text": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
